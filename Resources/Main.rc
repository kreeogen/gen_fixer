// ---- ENGLISH ----
IDD_FIXER_CFG DIALOGEX 0, 0, 232, 231
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CLIPSIBLINGS | WS_CAPTION | WS_GROUP
CAPTION "Winamp"
FONT 8, "MS Sans Serif", 0, 0, 0x0
BEGIN

/*
// --- блок элементов диалога (.rc-стиль) ---
    GROUPBOX      "Исправления",                -1,   5,  14, 221, 56, WS_CHILD | WS_VISIBLE
    AUTOCHECKBOX  "Fix minimize bug on start",             2001, 15, 28, 205, 10, WS_CHILD | WS_VISIBLE | WS_TABSTOP
    AUTOCHECKBOX  "Fix missing Preferences icon",         2002, 15, 40, 205, 10, WS_CHILD | WS_VISIBLE | WS_TABSTOP
    AUTOCHECKBOX  "Cyrillic video font fix (restart needed)", 2007, 15, 52, 205, 10, WS_CHILD | WS_VISIBLE | WS_TABSTOP  

    GROUPBOX      "Addons",                 -1,   5,  14, 221, 66, WS_CHILD | WS_VISIBLE
*/


    AUTOCHECKBOX  REST_ITEM,   2003, 10, 14, 205, 10, WS_CHILD | WS_VISIBLE | WS_TABSTOP
    AUTOCHECKBOX  MUTE,2004, 10, 26, 205, 10, WS_CHILD | WS_VISIBLE | WS_TABSTOP
    AUTOCHECKBOX  DELSKIN,2005, 10, 38, 205, 10, WS_CHILD | WS_VISIBLE | WS_TABSTOP
    AUTOCHECKBOX  PL_MENUS,       2006, 10, 50, 205, 10, WS_CHILD | WS_VISIBLE | WS_TABSTOP

    GROUPBOX      ADVSET, -1, 0, 0, 232, 231, WS_CHILD | WS_VISIBLE

    // Битмап-статик (оставляем CONTROL, потому что нужен SS_BITMAP)
    CONTROL       "", 1001, "STATIC", SS_BITMAP | SS_CENTERIMAGE | WS_CHILD | WS_VISIBLE, 192, 194, 36, 32

    // Правосторонний текст (SS_RIGHT -> RTEXT)
    RTEXT         LOGOINFO,
                  -1, 10, 206, 173, 20, WS_CHILD | WS_VISIBLE | WS_GROUP
END




